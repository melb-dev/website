---
import { formatEventDate, formatMelbourneDateTime, localDate, slug } from '../lib/events';

const { event, groups, venues, topics } = Astro.props;
const d = event.data;
const group = groups.find((item: any) => item.id === d.group.id);
const venue = venues.find((item: any) => item.id === d.venue?.id);
const topicNames = d.topics
  .map((ref: any) => topics.find((item: any) => item.id === ref.id))
  .filter(Boolean);
const locationId = d.format === 'online' ? 'online' : venue ? slug(venue.data.suburb) : 'unknown';
const searchText = [
  d.title,
  group.data.name,
  venue?.data.name,
  venue?.data.suburb,
  ...topicNames.map((topic: any) => topic.data.name),
]
  .filter(Boolean)
  .join(' ');
---

<article
  class="cardx directory-card"
  data-id={d.uid}
  data-search={searchText}
  data-name={d.title}
  data-start={d.start.toISOString()}
  data-end={d.end?.toISOString()}
  data-deadline={d.cfpDeadline?.toISOString()}
  data-cfp-type={d.cfpDeadline ? 'fixed' : 'rolling'}
  data-date={d.cfpDeadline ? localDate(d.cfpDeadline) : undefined}
  data-topics={d.topics.map((ref: any) => ref.id).join(',')}
  data-location={locationId}
  data-format={d.format}
  data-paid={String(d.paid)}
>
  <h2 class="event-title text-xl font-bold">
    <a href={d.url} rel="nofollow noopener noreferrer" target="_blank">{d.title}</a>
    {d.paid && <span class="cost-badge">Paid</span>}
    <span class="past-badge" data-past-badge hidden></span>
    {!d.cfpDeadline && <span class="event-type-badge">Rolling CFP</span>}
  </h2>
  {
    d.cfpDeadline ? (
      <p class="mt-2 font-bold">
        CFP <span data-cfp-verb>closes</span>{' '}
        <time datetime={d.cfpDeadline.toISOString()}>{formatMelbourneDateTime(d.cfpDeadline)}</time>
      </p>
    ) : (
      <p class="mt-2 font-bold" data-cfp-rolling>
        Submissions are accepted on a rolling basis with no fixed deadline.
      </p>
    )
  }
  <p class="mt-2">
    Event: <time datetime={d.allDay ? localDate(d.start) : d.start.toISOString()}>
      {formatEventDate(d.start, d.end, d.allDay)}
    </time>
  </p>
  <p>
    By <a href={`/groups/${group.id}/`}>{group.data.name}</a> · {
      d.format === 'online'
        ? 'Online'
        : venue
          ? `${venue.data.name}, ${venue.data.suburb}`
          : 'Location TBC'
    } · <span class="capitalize">{d.format}</span>
  </p>
  <div class="my-2">
    {topicNames.map((topic: any) => <span class="pill">{topic.data.name}</span>)}
  </div>
  <div class="cfp-actions">
    <a class="btn btn-sm" href={d.url} rel="nofollow noopener noreferrer" target="_blank">
      View event
      <span class="sr-only">details for {d.title}</span>
    </a>
    {
      d.cfpUrl ? (
        <a
          class="btn btn-sm btn-primary"
          data-cfp-open
          href={d.cfpUrl}
          rel="nofollow noopener noreferrer"
          target="_blank"
        >
          Submit a proposal
          <span class="sr-only">for {d.title}</span>
        </a>
      ) : (
        <span class="btn btn-sm" data-cfp-open aria-disabled="true">
          Submission link unavailable
        </span>
      )
    }
    <span class="btn btn-sm btn-past" data-cfp-closed aria-disabled="true" hidden></span>
  </div>
</article>
