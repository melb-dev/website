#!/usr/bin/env bash
set -euo pipefail

started_at=$SECONDS
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bun_version="1.3.6"
bun_install="$HOME/.bun"
bun_bin="$bun_install/bin/bun"

echo "==> Ensuring Bun $bun_version is installed"
if [[ ! -x "$bun_bin" ]] || [[ "$($bun_bin --version)" != "$bun_version" ]]; then
  if [[ "$(uname -s)" == "Linux" ]] && ! command -v unzip >/dev/null 2>&1; then
    apt_prefix=()
    if [[ $EUID -ne 0 ]]; then
      apt_prefix=(sudo)
    fi
    "${apt_prefix[@]}" apt-get update
    "${apt_prefix[@]}" apt-get install -y unzip
  fi

  curl -fsSL https://bun.com/install | BUN_INSTALL="$bun_install" bash -s "bun-v$bun_version"
fi

profile="$HOME/.bash_profile"
profile_marker="# melb.dev orb Bun"
if ! grep -Fqx "$profile_marker" "$profile" 2>/dev/null; then
  cat >> "$profile" <<'EOF'

# melb.dev orb Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
EOF
fi

echo "==> Installing dependencies from bun.lock"
cd "$repo_root"
"$bun_bin" install --frozen-lockfile

echo "==> Setup complete in $((SECONDS - started_at))s"
