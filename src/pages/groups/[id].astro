---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/EventCard.astro';
import { sortEvents } from '../../lib/events';

export async function getStaticPaths() {
  return (await getCollection('groups')).map((g) => ({
    params: { id: g.id },
    props: { group: g },
  }));
}

const { group } = Astro.props;
const [events, groups, venues, topics] = await Promise.all([
  getCollection('events'),
  getCollection('groups'),
  getCollection('venues'),
  getCollection('topics'),
]);
const own = sortEvents(
  events.filter((e) => e.data.group.id === group.id),
  true,
);
const groupTopics = group.data.topics.map((r) => topics.find((t) => t.id === r.id)).filter(Boolean);
const contactIsExternal = group.data.contact && !group.data.contact.includes('@');
---

<Layout title={group.data.name} description={group.data.summary}>
  <h1 class="group-title text-4xl font-black">
    {group.data.name}{
      group.data.communityFirst && <span class="community-first-badge">Recommended</span>
    }
  </h1>
  {group.data.status === 'inactive' && <p class="badge badge-warning my-3">Inactive group</p>}
  <p class="text-lg mt-3 max-w-3xl">{group.data.description}</p>
  <div class="mt-3">
    {groupTopics.map((t) => <span class="pill">{t?.data.name}</span>)}
  </div>
  <p class="mt-3">
    {group.data.location} · <a
      href={group.data.websiteUrl}
      rel="nofollow noopener noreferrer"
      target="_blank">Community website</a
    > · <a href={group.data.eventsUrl} rel="nofollow noopener noreferrer" target="_blank"
      >Events listing</a
    >{
      group.data.contact && (
        <>
          {' '}
          ·{' '}
          <a
            href={
              group.data.contact.includes('@') ? `mailto:${group.data.contact}` : group.data.contact
            }
            rel={contactIsExternal ? 'nofollow noopener noreferrer' : undefined}
            target={contactIsExternal ? '_blank' : undefined}
          >
            Public contact
          </a>
        </>
      )
    }
  </p>
  <section id="group-events">
    <h2 id="upcoming-heading" class="text-2xl font-bold mt-8 mb-3">Events</h2>
    <noscript>Enable JavaScript to separate upcoming and past events.</noscript>
    <div id="upcoming-events" class="grid gap-4 md:grid-cols-2">
      {own.map((e) => <EventCard event={e} groups={groups} venues={venues} topics={topics} />)}
    </div>
    <p id="no-upcoming-events" hidden={own.length > 0}>No events are listed.</p>
    <section id="past-events-section" hidden>
      <h2 class="text-2xl font-bold mt-8 mb-3">Past events</h2>
      <div id="past-events" class="grid gap-4 md:grid-cols-2"></div>
      <p id="no-past-events">No past events are listed.</p>
    </section>
  </section>
  <script>
    import { refreshEventDates, watchEventDates } from '../../scripts/event-dates';

    const root = document.querySelector('#group-events')!;
    const cards = [...root.querySelectorAll<HTMLElement>('.directory-card')];
    const upcoming = root.querySelector('#upcoming-events')!;
    const past = root.querySelector('#past-events')!;
    root.querySelector('#upcoming-heading')!.textContent = 'Upcoming events';
    root.querySelector<HTMLElement>('#past-events-section')!.hidden = false;
    root.querySelector('#no-upcoming-events')!.textContent = 'No upcoming events are listed.';
    watchEventDates(() => {
      const ordered: HTMLElement[] = refreshEventDates(cards);
      for (const [period, list] of [
        ['future', upcoming],
        ['past', past],
      ] as const) {
        ordered
          .filter((card) => card.dataset.period === period)
          .forEach((card, index) => {
            if (list.children[index] !== card) list.insertBefore(card, list.children[index]);
          });
      }
      root.querySelector<HTMLElement>('#no-upcoming-events')!.hidden =
        upcoming.childElementCount > 0;
      root.querySelector<HTMLElement>('#no-past-events')!.hidden = past.childElementCount > 0;
    });
  </script>
</Layout>
